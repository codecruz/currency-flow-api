{
    "name": "codecruz/currency-flow-server",
    "description": "HTTP API serving ECB euro exchange reference rates, built on codecruz/currency-flow.",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "codecruz"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.2",
        "codecruz/currency-flow": "*@dev",
        "psr/clock": "^1.0",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/cache": "^7.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CodeCruz\\CurrencyFlow\\Server\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeCruz\\CurrencyFlow\\Server\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S 127.0.0.1:8080 -t public"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
