{
    "name": "codecruz/currency-flow",
    "description": "Official ECB euro exchange reference rates since 1999: latest, historical, cross rates and conversions, with previous-business-day resolution.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "currency",
        "exchange rates",
        "ecb",
        "forex",
        "euro",
        "currency converter",
        "cross rates"
    ],
    "homepage": "https://codecruz.github.io/currency-flow-api/",
    "authors": [
        {
            "name": "codecruz"
        }
    ],
    "support": {
        "issues": "https://github.com/codecruz/currency-flow-api/issues",
        "source": "https://github.com/codecruz/currency-flow-api",
        "docs": "https://github.com/codecruz/currency-flow-api#php-library"
    },
    "require": {
        "php": "^8.2",
        "ext-xmlreader": "*",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "CodeCruz\\CurrencyFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeCruz\\CurrencyFlow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
